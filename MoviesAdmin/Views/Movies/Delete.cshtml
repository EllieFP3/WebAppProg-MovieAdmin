@model Movie

@{
    ViewData["Title"] = "Delete";
}

<h1 class="mb-3">Delete Movie Record</h1>
<div>
    <hr />
    <dl class="row">
        <dd class = "col-sm-10">
            <h4>You're about to delete the following movie: @Html.DisplayFor(model => model.Title)</h4>
        </dd>
    </dl>
    <h5>Are you sure?</h5>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
